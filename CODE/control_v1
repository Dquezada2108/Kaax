  client.println(F("  fetch('/ping',{signal:AbortSignal.timeout(2500)})"));
  client.println(F("  .then(()=>{if(!online){online=true;setConn(true);}})"));
  client.println(F("  .catch(()=>{if(online){online=false;setConn(false);}});"));
  client.println(F("}"));
  client.println(F("function setConn(up){"));
  client.println(F("  const dot=document.getElementById('dot'),lbl=document.getElementById('conn-lbl');"));
  client.println(F("  dot.className='dot '+(up?'online':'offline');"));
  client.println(F("  lbl.textContent=up?'CONNECTED':'OFFLINE';"));
  client.println(F("  addLog(up?'conn':'disc',up?'ROV CONNECTED':'ROV OFFLINE');"));
  client.println(F("}"));
  client.println(F("checkConn();setInterval(checkConn,3000);"));

  // ── BATTERY POLL ─────────────────────────────────────────────────────────────
  client.println(F("function pollBatt(){"));
  client.println(F("  fetch('/status').then(r=>r.json()).then(d=>{"));
  client.println(F("    const v=d.battV,el=document.getElementById('batt');"));
  client.println(F("    el.textContent='BATT '+v.toFixed(1)+'V';"));
  client.println(F("    el.className='batt'+(v<10.5?' low':v<11.5?' mid':'');"));
  client.println(F("  }).catch(()=>{});"));
  client.println(F("}"));
  client.println(F("pollBatt();setInterval(pollBatt,5000);"));

  // ── LOG SYSTEM ───────────────────────────────────────────────────────────────
  client.println(F("const logs=[];"));
  client.println(F("function addLog(type,msg){"));
  client.println(F("  const now=new Date();"));
  client.println(F("  const ts=now.toTimeString().slice(0,8);"));
  client.println(F("  logs.unshift({ts,type,msg});"));
  client.println(F("  if(logs.length>100)logs.pop();"));
  client.println(F("  renderLog();"));
  client.println(F("}"));
  client.println(F("function renderLog(){"));
  client.println(F("  const el=document.getElementById('log-list');"));
  client.println(F("  el.innerHTML=logs.map(l=>`<div class='log-entry'><span class='log-time'>${l.ts}</span><span class='log-msg ${l.type}'>${l.msg}</span></div>`).join('');"));
  client.println(F("}"));
  client.println(F("function clearLog(){logs.length=0;renderLog();}"));

  // ── ENVIRONMENT / SARGASSUM ──────────────────────────────────────────────────
  client.println(F("let envLoaded=false;"));
  client.println(F("function loadEnv(){"));
  client.println(F("  envLoaded=true;"));
  // Open-Meteo Marine API — Riviera Maya coordinates
  client.println(F("  const url='https://marine-api.open-meteo.com/v1/marine?latitude=20.7&longitude=-87.1&current=wave_height,wave_period,sea_surface_temperature,wind_speed_10m&wind_speed_unit=kmh';"));
  client.println(F("  fetch(url).then(r=>r.json()).then(d=>{"));
  client.println(F("    const c=d.current;"));
  client.println(F("    set('ev-wh',c.wave_height!=null?c.wave_height.toFixed(2):'N/A');"));
  client.println(F("    set('ev-wp',c.wave_period!=null?c.wave_period.toFixed(1):'N/A');"));
  client.println(F("    set('ev-sst',c.sea_surface_temperature!=null?c.sea_surface_temperature.toFixed(1):'N/A');"));
  client.println(F("    set('ev-ws',c.wind_speed_10m!=null?c.wind_speed_10m.toFixed(1):'N/A');"));
  // Sargassum risk heuristic:
  // High risk: SST >= 27°C (warm water promotes growth) AND wave height < 0.8m (calm = accumulation)
  // Moderate: SST >= 25°C OR wave height < 1.0m
  // Low: otherwise
  client.println(F("    const sst=c.sea_surface_temperature,wh=c.wave_height;"));
  client.println(F("    const el=document.getElementById('sarg-status'),note=document.getElementById('sarg-note');"));
  client.println(F("    if(sst>=27&&wh<0.8){el.className='sarg-status high';el.textContent='HIGH RISK';"));
  client.println(F("      note.textContent='Warm, calm conditions favor sargassum accumulation. Check beach reports before deployment.';}"));
  client.println(F("    else if(sst>=25||wh<1.0){el.className='sarg-status mod';el.textContent='MODERATE RISK';"));
  client.println(F("      note.textContent='Conditions may allow sargassum presence. Monitor local reports.';}"));
  client.println(F("    else{el.className='sarg-status low';el.textContent='LOW RISK';"));
  client.println(F("      note.textContent='Current conditions are unfavorable for sargassum accumulation.';}"));
  client.println(F("  }).catch(()=>{"));
  client.println(F("    document.getElementById('sarg-status').textContent='UNAVAILABLE';"));
  client.println(F("    document.getElementById('sarg-note').textContent='Could not reach marine API. Check internet connection.';"));
  client.println(F("  });"));
  client.println(F("}"));
  client.println(F("function set(id,v){document.getElementById(id).textContent=v;}"));
  client.println(F("</script></body></html>"));

  client.stop();
}
