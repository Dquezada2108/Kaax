#include <WiFiS3.h>
#include <Servo.h>

//Version prior to our Raspberry when we used an Arduino

// ── AP CREDENTIALS ────────────────────────────────────────────────────────────
const char ssid[] = "ROV_Control";
const char pass[] = "12345678";

// ── BATTERY VOLTAGE DIVIDER ───────────────────────────────────────────────────
// Wire a voltage divider from battery+ to A0:
//   Batt+ ── R1(30kΩ) ── A0 ── R2(10kΩ) ── GND
// This scales up to ~20V safely to 0-5V on A0.
// For a 3S LiPo (max 12.6V) or 4S (max 16.8V) this works fine.
// Adjust BATT_RATIO if you use different resistors: ratio = (R1+R2)/R2
#define BATT_PIN    A0
#define BATT_RATIO  4.0f   // (30k+10k)/10k

WiFiServer server(80);

Servo escR;
Servo escL;

int targetR = 1500;
int targetL = 1500;

// ── BATTERY READ ──────────────────────────────────────────────────────────────
float readBattery() {
  int raw = analogRead(BATT_PIN);
  return (raw / 1023.0f) * 5.0f * BATT_RATIO;
}

// ── SETUP ─────────────────────────────────────────────────────────────────────
void setup() {
  Serial.begin(9600);

  escR.attach(9);
  escL.attach(10);
  escR.writeMicroseconds(1500);
  escL.writeMicroseconds(1500);
  delay(3000);

  WiFi.beginAP(ssid, pass);
  Serial.println(F("AP ready — SSID: ROV_Control"));
  Serial.println(F("Open: http://192.168.4.1"));

  server.begin();
}

// ── LOOP ──────────────────────────────────────────────────────────────────────
void loop() {
  escR.writeMicroseconds(targetR);
  escL.writeMicroseconds(targetL);

  WiFiClient client = server.available();
  if (!client) return;

  String req = client.readStringUntil('\r');
  client.flush();

  // ── COMMAND PARSING ─────────────────────────────────────────────────────────
  if (req.indexOf("/cmd?") != -1) {
    int rIdx = req.indexOf("R=");
    int lIdx = req.indexOf("L=");
    if (rIdx != -1) targetR = constrain(req.substring(rIdx + 2).toInt(), 1100, 1900);
    if (lIdx != -1) targetL = constrain(req.substring(lIdx + 2).toInt(), 1100, 1900);
  }
  if (req.indexOf("/stop") != -1) { targetR = 1500; targetL = 1500; }

  // ── RESPONSE HEADERS ────────────────────────────────────────────────────────
  client.println(F("HTTP/1.1 200 OK"));

  // ── /ping — heartbeat ────────────────────────────────────────────────────────
  if (req.indexOf("/ping") != -1) {
    client.println(F("Content-type:text/plain\n"));
    client.println(F("pong"));
    client.stop(); return;
  }

  // ── /status — battery JSON ───────────────────────────────────────────────────
  if (req.indexOf("/status") != -1) {
    client.println(F("Content-type:application/json"));
    client.println(F("Access-Control-Allow-Origin:*\n"));
    client.print(F("{\"battV\":"));
    client.print(readBattery(), 2);
    client.print(F(",\"R\":"));
    client.print(targetR);
    client.print(F(",\"L\":"));
    client.print(targetL);
    client.println(F("}"));
    client.stop(); return;
  }

  // ── API calls — early exit ───────────────────────────────────────────────────
  if (req.indexOf("/cmd?") != -1 || req.indexOf("/stop") != -1) {
    client.println(F("Content-type:text/plain\n"));
    client.println(F("OK"));
    client.stop(); return;
